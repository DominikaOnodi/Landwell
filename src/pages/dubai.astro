---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const guides = [
  {
    id: "explorer",
    name: "The Explorer",
    image: "/mascots/explorer.png",
    imageAlt: "The Explorer mascot",
    tagline: "Discover neighbourhoods, cafés, souks and the desert city.",
    cta: "Explore Dubai",
    href: "/dubai/explorer",
    bg: "var(--sage-pale)",
  },
  {
    id: "anchor",
    name: "The Anchor",
    image: "/mascots/anchor.png",
    imageAlt: "The Anchor mascot",
    tagline: "Visas, renting, banking and everything else to settle in.",
    cta: "Get settled",
    href: "/dubai/anchor",
    bg: "var(--terracotta-pale)",
  },
  {
    id: "connector",
    name: "The Connector",
    image: "/mascots/connector.png",
    imageAlt: "The Connector mascot",
    tagline: "Meet people, find communities and build your Dubai network.",
    cta: "Find your people",
    href: "/dubai/connector",
    bg: "var(--cream-dark)",
  },
];

const stats = [
  { value: "200+",  label: "nationalities call it home" },
  { value: "85%",   label: "of residents are expats" },
  { value: "0%",    label: "personal income tax" },
  { value: "330+",  label: "sunny days a year" },
];
---

<Layout
  title="Dubai — Landwell"
  description="Your guide to living, exploring and connecting in Dubai. Built for the internationals who make up 85% of this city."
>
  <Nav />

  <!-- ── Hero ─────────────────────────────── -->
  <section class="city-hero">

    <div class="city-hero__skyline" aria-hidden="true">
      <svg viewBox="0 0 1400 200" preserveAspectRatio="xMidYMax meet" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Left cluster -->
        <rect x="0"   y="120" width="45"  height="80"  fill="rgba(255,210,120,0.05)"/>
        <rect x="50"  y="95"  width="60"  height="105" fill="rgba(255,210,120,0.06)"/>
        <rect x="115" y="105" width="40"  height="95"  fill="rgba(255,210,120,0.05)"/>
        <rect x="160" y="80"  width="50"  height="120" fill="rgba(255,210,120,0.06)"/>
        <!-- Burj Al Arab (sail shape) -->
        <path d="M248 200 L248 60 Q258 20 290 45 L290 200 Z" fill="rgba(255,210,120,0.07)"/>
        <!-- Mid towers -->
        <rect x="310" y="85"  width="38"  height="115" fill="rgba(255,210,120,0.06)"/>
        <rect x="355" y="65"  width="30"  height="135" fill="rgba(255,210,120,0.07)"/>
        <rect x="392" y="90"  width="42"  height="110" fill="rgba(255,210,120,0.05)"/>
        <!-- Burj Khalifa — tallest, tapered spire -->
        <polygon points="476,200 476,145 479,145 474,105 478,105 473,65 477,65 472,30 480,0 488,30 492,65 487,65 491,105 486,105 490,145 484,145 484,200" fill="rgba(255,210,120,0.10)"/>
        <!-- Downtown cluster around Burj Khalifa -->
        <rect x="500" y="75"  width="35"  height="125" fill="rgba(255,210,120,0.07)"/>
        <rect x="542" y="88"  width="28"  height="112" fill="rgba(255,210,120,0.06)"/>
        <rect x="577" y="68"  width="44"  height="132" fill="rgba(255,210,120,0.07)"/>
        <!-- Dubai Frame (two vertical towers) -->
        <rect x="638" y="85"  width="14"  height="115" fill="rgba(255,210,120,0.07)"/>
        <rect x="660" y="85"  width="14"  height="115" fill="rgba(255,210,120,0.07)"/>
        <rect x="638" y="85"  width="36"  height="6"   fill="rgba(255,210,120,0.07)"/>
        <!-- DIFC / financial district -->
        <rect x="700" y="60"  width="48"  height="140" fill="rgba(255,210,120,0.07)"/>
        <rect x="755" y="72"  width="36"  height="128" fill="rgba(255,210,120,0.06)"/>
        <rect x="798" y="82"  width="42"  height="118" fill="rgba(255,210,120,0.05)"/>
        <!-- Marina towers -->
        <rect x="860" y="50"  width="38"  height="150" fill="rgba(255,210,120,0.08)"/>
        <rect x="905" y="68"  width="32"  height="132" fill="rgba(255,210,120,0.06)"/>
        <rect x="944" y="55"  width="44"  height="145" fill="rgba(255,210,120,0.07)"/>
        <rect x="995" y="75"  width="36"  height="125" fill="rgba(255,210,120,0.06)"/>
        <!-- Right skyline -->
        <rect x="1050" y="88" width="50"  height="112" fill="rgba(255,210,120,0.05)"/>
        <rect x="1108" y="70" width="40"  height="130" fill="rgba(255,210,120,0.06)"/>
        <rect x="1155" y="85" width="55"  height="115" fill="rgba(255,210,120,0.05)"/>
        <rect x="1218" y="65" width="44"  height="135" fill="rgba(255,210,120,0.07)"/>
        <rect x="1270" y="78" width="60"  height="122" fill="rgba(255,210,120,0.05)"/>
        <rect x="1340" y="92" width="60"  height="108" fill="rgba(255,210,120,0.05)"/>
        <!-- Desert sand horizon -->
        <rect x="0" y="194" width="1400" height="6" fill="rgba(255,210,120,0.08)"/>
      </svg>
    </div>

    <span class="hs hs--1" aria-hidden="true">✦</span>
    <span class="hs hs--2" aria-hidden="true">✦</span>
    <span class="hs hs--3" aria-hidden="true">✦</span>

    <div class="container city-hero__inner">
      <a href="/" class="city-hero__back">← Landwell</a>
      <p class="city-hero__eyebrow">United Arab Emirates ✦</p>
      <h1 class="city-hero__name">Dubai</h1>
      <p class="city-hero__tagline">Zero income tax. 330 sunny days.<br>The world's most international city.</p>
      <a href="#guides" class="city-hero__scroll" aria-label="Scroll to guides">· · ·</a>
    </div>
  </section>

  <!-- ── Three guides ──────────────────────── -->
  <section id="guides" class="city-guides section">
    <div class="container">
      <div class="city-guides__header">
        <span class="eyebrow">Your guides to Dubai ✦</span>
        <h2 class="city-guides__title">How would you like to start?</h2>
      </div>

      <div class="city-guides__grid">
        {guides.map((g) => (
          <a href={g.href} class={`cg-card cg-card--${g.id}`} style={`--cg-bg: ${g.bg};`}>
            <div class="cg-card__figure">
              <img src={g.image} alt={g.imageAlt} class="cg-card__img" loading="lazy" width="200" height="230"/>
            </div>
            <div class="cg-card__body">
              <h3 class="cg-card__name">{g.name}</h3>
              <p class="cg-card__tagline">{g.tagline}</p>
              <span class="cg-card__cta">{g.cta} <span class="cg-arrow">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── About Dubai ──────────────────────── -->
  <section class="city-about section">
    <div class="container">
      <div class="city-about__inner">

        <div class="city-about__text">
          <span class="eyebrow">Get to know Dubai ✦</span>
          <h2 class="city-about__heading">Built for arrivals.<br>All of them.</h2>
          <p>Dubai is unlike anywhere else on earth. A city that built itself from desert in less than fifty years — and did it almost entirely with people who came from somewhere else. Over 85% of its residents were not born here. That's not a statistic; it's the whole point. In Dubai, being an arrival is completely normal.</p>
          <p>There's a reason people keep choosing it: zero personal income tax, world-class infrastructure, sunshine almost every day of the year, and a restless, ambitious energy that you either love immediately or grow to love. The practical side of arriving can be complex — visas, employer sponsorship, post-dated rent cheques — but once you're in, you're in. This city rewards those who show up.</p>
        </div>

        <div class="city-about__stats">
          {stats.map((s) => (
            <div class="stat-chip">
              <span class="stat-chip__value">{s.value}</span>
              <span class="stat-chip__label">{s.label}</span>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ── Start exploring ───────────────────── -->
  <section class="city-start section">
    <div class="container">
      <div class="city-start__header">
        <span class="eyebrow">Explore by category ✦</span>
        <h2 class="city-start__title">Where would you like to go?</h2>
        <p class="city-start__sub">Dubai guides are growing — more content added regularly.</p>
      </div>

      <div class="city-start__grid">
        <a href="/dubai/visas" class="start-card start-card--live">
          <span class="start-card__icon">📋</span>
          <span class="start-card__label">Visas &amp; Residence</span>
          <span class="start-card__badge">Anchor</span>
        </a>
        <a href="/dubai/renting" class="start-card start-card--live">
          <span class="start-card__icon">🏠</span>
          <span class="start-card__label">Renting in Dubai</span>
          <span class="start-card__badge">Anchor</span>
        </a>
        <a href="/dubai/banking" class="start-card start-card--live">
          <span class="start-card__icon">🏦</span>
          <span class="start-card__label">Banking</span>
          <span class="start-card__badge">Anchor</span>
        </a>
        <div class="start-card start-card--soon">
          <span class="start-card__icon">🌆</span>
          <span class="start-card__label">Neighbourhoods</span>
          <span class="start-card__badge">Coming soon</span>
        </div>
        <div class="start-card start-card--soon">
          <span class="start-card__icon">🏥</span>
          <span class="start-card__label">Healthcare</span>
          <span class="start-card__badge">Coming soon</span>
        </div>
        <div class="start-card start-card--soon">
          <span class="start-card__icon">☕</span>
          <span class="start-card__label">Cafés &amp; Brunch</span>
          <span class="start-card__badge">Coming soon</span>
        </div>
        <div class="start-card start-card--soon">
          <span class="start-card__icon">🎉</span>
          <span class="start-card__label">Events &amp; Community</span>
          <span class="start-card__badge">Coming soon</span>
        </div>
        <div class="start-card start-card--soon">
          <span class="start-card__icon">🏜️</span>
          <span class="start-card__label">Desert &amp; Outdoors</span>
          <span class="start-card__badge">Coming soon</span>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ── Hero ──────────────────────────────────── */
  .city-hero {
    min-height: 92svh;
    background: #1C1508;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding-top: 90px;
    padding-bottom: var(--space-20);
  }

  .city-hero__skyline {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    pointer-events: none;
  }

  .city-hero__skyline svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .hs {
    position: absolute;
    color: #C87941;
    pointer-events: none;
    user-select: none;
    animation: hs-float 5s ease-in-out infinite;
  }

  .hs--1 { top: 18%; left: 6%;   font-size: 1rem;   opacity: 0.3;  animation-delay: 0s; }
  .hs--2 { top: 12%; right: 8%;  font-size: 0.7rem;  opacity: 0.22; animation-delay: 1.5s; }
  .hs--3 { bottom: 25%; right: 6%; font-size: 0.85rem; opacity: 0.25; animation-delay: 3s; }

  @keyframes hs-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%       { transform: translateY(-9px) rotate(20deg); }
  }

  .city-hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .city-hero__back {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.4);
    text-decoration: none;
    transition: color 0.2s;
    margin-bottom: var(--space-4);
  }

  .city-hero__back:hover { color: rgba(255,255,255,0.75); }

  .city-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #E8A870;
    opacity: 0.85;
  }

  .city-hero__name {
    font-family: var(--font-heading);
    font-size: clamp(5.5rem, 18vw, 14rem);
    font-weight: 300;
    font-style: italic;
    color: var(--cream);
    line-height: 0.88;
    letter-spacing: -0.02em;
  }

  .city-hero__tagline {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-xl), 2.8vw, var(--text-3xl));
    font-weight: 300;
    color: rgba(255,255,255,0.5);
    line-height: 1.4;
    margin-top: var(--space-2);
    max-width: 100%;
  }

  .city-hero__scroll {
    margin-top: var(--space-10);
    font-size: var(--text-lg);
    color: #E8A870;
    opacity: 0.5;
    letter-spacing: 0.4em;
    text-decoration: none;
  }

  /* ── Three guides — reuse London styles ───── */
  .city-guides { background: var(--cream); }

  .city-guides__header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .city-guides__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: 400;
    color: var(--sage);
  }

  .city-guides__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 680px) { .city-guides__grid { grid-template-columns: repeat(3, 1fr); } }

  .cg-card {
    display: flex;
    flex-direction: column;
    background: var(--cg-bg);
    border-radius: 999px 999px var(--radius-xl) var(--radius-xl);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: transform 0.28s ease, box-shadow 0.28s ease;
  }

  .cg-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg); }
  .cg-card:hover .cg-card__img { transform: scale(1.06) translateY(-5px); }
  .cg-card:hover .cg-arrow { transform: translateX(5px); }

  .cg-card__figure {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: var(--space-8) var(--space-8) 0;
    min-height: 220px;
  }

  .cg-card__img {
    width: 100%;
    max-width: 180px;
    height: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform 0.3s ease;
  }

  .cg-card__body {
    padding: var(--space-5) var(--space-6) var(--space-8);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    flex: 1;
  }

  .cg-card__name {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 400;
    font-style: italic;
    color: var(--sage);
  }

  .cg-card__tagline {
    font-size: var(--text-sm);
    color: var(--text-medium);
    line-height: 1.65;
    max-width: 22ch;
  }

  .cg-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--terracotta);
  }

  .cg-arrow { display: inline-block; transition: transform 0.2s ease; }

  @media (max-width: 679px) {
    .cg-card { flex-direction: row; border-radius: var(--radius-xl); align-items: center; }
    .cg-card__figure { min-height: unset; width: 120px; flex-shrink: 0; padding: var(--space-4) var(--space-3) var(--space-4) var(--space-5); align-items: center; }
    .cg-card__img { max-width: 80px; }
    .cg-card:hover .cg-card__img { transform: scale(1.04) translateY(0); }
    .cg-card__body { text-align: left; align-items: flex-start; padding: var(--space-5) var(--space-5) var(--space-5) var(--space-2); }
  }

  /* ── About Dubai ─────────────────────────── */
  .city-about { background: var(--sage-pale); }

  .city-about__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-16);
  }

  @media (min-width: 800px) {
    .city-about__inner { grid-template-columns: 1fr 1fr; align-items: start; gap: var(--space-20); }
  }

  .city-about__heading {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: 400;
    font-style: italic;
    color: var(--sage);
    line-height: 1.15;
    margin-block: var(--space-4) var(--space-8);
  }

  .city-about__text p {
    font-size: clamp(var(--text-base), 1.6vw, var(--text-lg));
    color: var(--text-medium);
    line-height: 1.85;
    max-width: 100%;
  }

  .city-about__text p + p { margin-top: var(--space-5); }

  .city-about__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    align-content: start;
  }

  .stat-chip {
    background: white;
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .stat-chip__value {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 400;
    color: var(--sage);
    line-height: 1;
  }

  .stat-chip__label { font-size: var(--text-sm); color: var(--text-medium); }

  /* ── Categories ─────────────────────────── */
  .city-start { background: var(--cream); }

  .city-start__header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .city-start__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: 400;
    color: var(--sage);
    margin-bottom: var(--space-3);
  }

  .city-start__sub {
    font-size: var(--text-sm);
    color: var(--text-light);
    max-width: 44ch;
    margin-inline: auto;
  }

  .city-start__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 600px) { .city-start__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .city-start__grid { grid-template-columns: repeat(4, 1fr); } }

  .start-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .start-card--live { background: var(--white); box-shadow: var(--shadow-sm); cursor: pointer; }
  .start-card--live:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .start-card--soon { background: var(--cream-dark); opacity: 0.6; cursor: default; }

  .start-card__icon { font-size: var(--text-2xl); line-height: 1; }

  .start-card__label {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--sage);
    flex: 1;
  }

  .start-card__badge {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--terracotta);
    align-self: flex-start;
  }

  .start-card--soon .start-card__badge { color: var(--text-light); }
</style>
