---
import GlobeCanvas from './GlobeCanvas.astro';

const comingSoonCities = [
  { name: "Lisbon"    },
  { name: "Amsterdam" },
  { name: "Paris"     },
];
---

<section id="explore" class="map-section section">
  <div class="container">

    <div class="map-section__header">
      <span class="eyebrow">Explore the World ✦</span>
      <h2 class="map-section__title">Find your next home.</h2>
      <p class="map-section__intro">
        Two cities live. More joining soon — click a pin to explore.
      </p>
    </div>

    <div class="globe-stage">
      <GlobeCanvas navigatable={true} />
    </div>

    <!-- Coming soon chips -->
    {comingSoonCities.length > 0 && (
      <div class="coming-soon">
        <p class="coming-soon__label">Coming soon</p>
        <ul class="coming-soon__list">
          {comingSoonCities.map((city) => (
            <li class="coming-soon__chip">
              <span class="coming-soon__dot" aria-hidden="true"></span>
              {city.name}
            </li>
          ))}
        </ul>
      </div>
    )}

  </div>
</section>

<style>
  .map-section {
    background: linear-gradient(180deg, var(--cream) 0%, var(--cream-dark) 100%);
  }

  /* ── Header ─────────────────────────────── */
  .map-section__header {
    text-align: center;
    margin-bottom: var(--space-16);
  }

  .map-section__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 400;
    font-style: italic;
    color: var(--sage);
    margin-bottom: var(--space-4);
  }

  .map-section__intro {
    font-size: var(--text-lg);
    color: var(--text-medium);
    max-width: 46ch;
    margin-inline: auto;
    line-height: 1.7;
  }

  /* ── Globe stage ─────────────────────────── */
  .globe-stage {
    width: clamp(300px, 58vw, 560px);
    margin-inline: auto;
    margin-bottom: var(--space-12);
  }

  /* ── Coming soon ─────────────────────────── */
  .coming-soon { text-align: center; }

  .coming-soon__label {
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-light);
    margin-bottom: var(--space-4);
  }

  .coming-soon__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .coming-soon__chip {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-medium);
    background: var(--white);
    border: 1.5px solid rgba(61, 90, 64, 0.12);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
    opacity: 0.7;
  }

  .coming-soon__dot {
    width: 6px;
    height: 6px;
    background: var(--text-light);
    border-radius: 50%;
    flex-shrink: 0;
  }


</style>
