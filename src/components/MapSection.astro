---
import GlobeCanvas from './GlobeCanvas.astro';

const activeCities = [
  { name: "London", country: "United Kingdom", flag: "🇬🇧", href: "/london" },
  { name: "Dubai",  country: "United Arab Emirates", flag: "🇦🇪", href: "/dubai"  },
];

const comingSoonCities = [
  { name: "Lisbon"    },
  { name: "Amsterdam" },
  { name: "Paris"     },
];
---

<section id="explore" class="map-section section">
  <canvas class="stars-bg" aria-hidden="true"></canvas>
  <div class="container">

    <div class="map-section__header">
      <span class="eyebrow">Explore the World ✦</span>
      <h2 class="map-section__title">Find your next home.</h2>
      <p class="map-section__intro">
        Two cities live. More joining soon — click a pin to explore.
      </p>
    </div>

    <div class="globe-stage">
      <GlobeCanvas navigatable={true} />
    </div>

    <!-- Live city cards — always visible, globe-independent -->
    <div class="city-row">
      <p class="city-row__label">Explore now ✦</p>
      <div class="city-row__cards">
        {activeCities.map((city) => (
          <a href={city.href} class="city-card">
            <span class="city-card__flag">{city.flag}</span>
            <span class="city-card__dot" aria-hidden="true"></span>
            <span class="city-card__text">
              <span class="city-card__name">{city.name}</span>
              <span class="city-card__country">{city.country}</span>
            </span>
            <span class="city-card__arrow">→</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Coming soon chips -->
    {comingSoonCities.length > 0 && (
      <div class="coming-soon">
        <p class="coming-soon__label">Coming soon</p>
        <ul class="coming-soon__list">
          {comingSoonCities.map((city) => (
            <li class="coming-soon__chip">
              <span class="coming-soon__dot" aria-hidden="true"></span>
              {city.name}
            </li>
          ))}
        </ul>
      </div>
    )}

  </div>
</section>

<style>
  .map-section {
    background: #05090f;
    position: relative;
    overflow: hidden;
  }

  .stars-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .map-section > .container {
    position: relative;
    z-index: 1;
  }

  /* ── Header ─────────────────────────────── */
  .map-section__header {
    text-align: center;
    margin-bottom: var(--space-16);
  }

  .map-section .eyebrow {
    color: rgba(200, 121, 65, 0.85);
  }

  .map-section__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 400;
    font-style: italic;
    color: var(--cream);
    margin-bottom: var(--space-4);
  }

  .map-section__intro {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.50);
    max-width: 46ch;
    margin-inline: auto;
    line-height: 1.7;
  }

  /* ── Globe stage ─────────────────────────── */
  .globe-stage {
    width: clamp(300px, 58vw, 560px);
    margin-inline: auto;
    margin-bottom: var(--space-12);
  }

  /* ── Live city cards ────────────────────── */
  .city-row {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .city-row__label {
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.38);
    margin-bottom: var(--space-5);
  }

  .city-row__cards {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  .city-card {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-full);
    text-decoration: none;
    color: inherit;
    transition: transform 0.22s ease, background 0.22s, border-color 0.22s;
  }

  .city-card:hover {
    transform: translateY(-3px);
    background: var(--sage);
    border-color: transparent;
  }

  .city-card:hover .city-card__name    { color: white; }
  .city-card:hover .city-card__country { color: rgba(255,255,255,0.6); }
  .city-card:hover .city-card__dot     { background: var(--terracotta-light); }
  .city-card:hover .city-card__arrow   { color: var(--terracotta-light); transform: translateX(4px); }

  .city-card__flag { font-size: var(--text-xl); line-height: 1; }

  .city-card__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--terracotta);
    flex-shrink: 0;
  }

  .city-card__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .city-card__name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--cream);
    line-height: 1;
    transition: color 0.22s;
  }

  .city-card__country {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 0.22s;
  }

  .city-card__arrow {
    font-size: var(--text-sm);
    color: var(--terracotta);
    margin-left: var(--space-1);
    display: inline-block;
    transition: transform 0.2s, color 0.22s;
  }

  /* ── Coming soon ─────────────────────────── */
  .coming-soon { text-align: center; }

  .coming-soon__label {
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.32);
    margin-bottom: var(--space-4);
  }

  .coming-soon__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .coming-soon__chip {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.38);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
  }

  .coming-soon__dot {
    width: 6px;
    height: 6px;
    background: rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>

<script is:inline>
(function () {
  var canvas = document.querySelector('.stars-bg:not([data-init])');
  if (!canvas) return;
  canvas.dataset.init = '1';

  var section = canvas.parentElement;
  var ctx     = canvas.getContext('2d');
  var W = 0, H = 0;

  function resize() {
    W = section.offsetWidth  || window.innerWidth;
    H = section.offsetHeight || 600;
    canvas.width  = W;
    canvas.height = H;
  }
  resize();
  window.addEventListener('resize', resize);

  var COLS  = ['255,255,255', '200,220,255', '255,248,210', '180,210,255'];
  var COUNT = 240;
  var stars = [];
  for (var i = 0; i < COUNT; i++) {
    stars.push({
      x:     Math.random(),
      y:     Math.random(),
      r:     Math.pow(Math.random(), 2.5) * 2.4 + 0.25,
      base:  Math.random() * 0.50 + 0.20,
      amp:   Math.random() * 0.50 + 0.10,
      speed: Math.random() * 1.4  + 0.15,
      phase: Math.random() * Math.PI * 2,
      col:   COLS[Math.floor(Math.random() * COLS.length)],
    });
  }

  var nebulae = [
    { x: 0.12, y: 0.18, r: 0.30, col: '70,35,130',  op: 0.055 },
    { x: 0.85, y: 0.72, r: 0.28, col: '20,55,130',  op: 0.065 },
    { x: 0.50, y: 0.08, r: 0.22, col: '35,70,150',  op: 0.040 },
    { x: 0.78, y: 0.25, r: 0.18, col: '60,20,100',  op: 0.035 },
  ];

  function drawNebulae() {
    for (var i = 0; i < nebulae.length; i++) {
      var n = nebulae[i];
      var cx = n.x * W, cy = n.y * H, rad = n.r * Math.min(W, H);
      var g  = ctx.createRadialGradient(cx, cy, 0, cx, cy, rad);
      g.addColorStop(0, 'rgba(' + n.col + ',' + n.op + ')');
      g.addColorStop(1, 'rgba(' + n.col + ',0)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(cx, cy, rad, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  function draw(t) {
    ctx.clearRect(0, 0, W, H);
    drawNebulae();
    for (var i = 0; i < stars.length; i++) {
      var s  = stars[i];
      var op = s.base + Math.sin(t * s.speed + s.phase) * s.amp;
      op = op < 0.03 ? 0.03 : op > 1 ? 1 : op;
      ctx.beginPath();
      ctx.arc(s.x * W, s.y * H, s.r, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(' + s.col + ',' + op.toFixed(2) + ')';
      ctx.fill();
    }
    requestAnimationFrame(function (ms) { draw(ms * 0.001); });
  }

  requestAnimationFrame(function (ms) { draw(ms * 0.001); });
})();
</script>
