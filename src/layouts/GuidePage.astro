---
// GuidePage.astro — shared layout for all Anchor / Explorer / Connector guides
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title:        string;
  description?: string;
  category:     string;
  categoryHref: string;
  heroBg:       string;
  readTime:     string;
  lastUpdated:  string;
  mascotSrc?:   string;   // override the default mascot with a page-specific illustration
}

const { title, description, category, categoryHref, heroBg, readTime, lastUpdated, mascotSrc } = Astro.props;

// Auto-detect mascot from category, or use the page-specific override
const mascotMap: Record<string, string> = {
  '/explorer': '/mascots/explorer.png',
  '/anchor':   '/mascots/anchor.png',
  '/connector':'/mascots/connector.png',
};
const resolvedMascot = mascotSrc ?? mascotMap[categoryHref];
---

<Layout title={`${title} — Landwell`} description={description}>
  <Nav />

  <!-- Guide header -->
  <header class="guide-header" style={`--gh-bg: ${heroBg};`}>
    <span class="gh-spark gh-spark--1" aria-hidden="true">✦</span>
    <span class="gh-spark gh-spark--2" aria-hidden="true">✦</span>
    <span class="gh-spark gh-spark--3" aria-hidden="true">✦</span>

    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Landwell</a>
        <span aria-hidden="true">·</span>
        <a href={categoryHref}>{category}</a>
        <span aria-hidden="true">·</span>
        <span>{title}</span>
      </nav>

      <div class="gh-inner">
        <div class="gh-text">
          <span class="guide-header__badge">{category}</span>
          <h1 class="guide-header__title">{title}</h1>
          <p class="guide-header__meta">
            <span>📖 {readTime} read</span>
            <span aria-hidden="true">·</span>
            <span>Last reviewed {lastUpdated}</span>
          </p>
        </div>

        {resolvedMascot && (
          <div class="gh-mascot" aria-hidden="true">
            <img src={resolvedMascot} alt="" class="gh-mascot__img" />
          </div>
        )}
      </div>
    </div>
  </header>

  <!-- Guide body -->
  <div class="guide-body">
    <div class="container">
      <div class="guide-content">
        <slot />
      </div>

      <aside class="guide-disclaimer">
        <p>
          <strong>Please note:</strong> This guide is for general information only and does
          not constitute financial, legal or immigration advice. Details, fees and eligibility
          requirements change — always verify directly with the relevant provider or official
          source before making any decisions. Some links on this page may be affiliate links;
          if you sign up or purchase through them we may earn a small commission at no extra
          cost to you. We only recommend services we genuinely think are useful.
        </p>
      </aside>
    </div>
  </div>

  <Footer />
</Layout>

<style is:global>
  /* ── Guide header ───────────────────────── */
  .guide-header {
    /* Fade from header colour into cream so it dissolves into the body */
    background: linear-gradient(180deg, var(--gh-bg) 55%, var(--cream) 100%);
    padding-top: 100px;
    padding-bottom: var(--space-16);
    position: relative;
    overflow: hidden;
  }

  /* Sparkles */
  .gh-spark {
    position: absolute;
    color: var(--terracotta);
    pointer-events: none;
    user-select: none;
    animation: gh-float 5s ease-in-out infinite;
    opacity: 0;
  }

  .gh-spark--1 { top: 20%;    right: 30%; font-size: 0.9rem;  opacity: 0.25; animation-delay: 0s; }
  .gh-spark--2 { top: 55%;    right: 8%;  font-size: 0.65rem; opacity: 0.18; animation-delay: 1.8s; }
  .gh-spark--3 { bottom: 18%; left: 5%;   font-size: 0.75rem; opacity: 0.2;  animation-delay: 3.2s; }

  @keyframes gh-float {
    0%, 100% { transform: translateY(0) rotate(0deg);   opacity: var(--op, 0.2); }
    50%       { transform: translateY(-7px) rotate(15deg); }
  }

  /* Inner layout: text + mascot side by side */
  .gh-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .gh-text { flex: 1; }

  /* Mascot */
  .gh-mascot {
    flex-shrink: 0;
    margin-bottom: -var(--space-4);
  }

  .gh-mascot__img {
    width: auto;
    max-width: clamp(90px, 12vw, 150px);
    max-height: 190px;
    height: auto;
    display: block;
    object-fit: contain;
    mix-blend-mode: multiply;
    filter: drop-shadow(0 6px 14px rgba(74, 44, 26, 0.10));
    animation: mascot-float 4s ease-in-out infinite;
    opacity: 0.85;
  }

  @keyframes mascot-float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-10px); }
  }

  @media (max-width: 560px) {
    .gh-mascot { display: none; }
  }

  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-light);
    margin-bottom: var(--space-8);
  }

  .breadcrumb a {
    color: var(--text-medium);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover { color: var(--sage); }

  /* Badge */
  .guide-header__badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--terracotta);
    color: white;
    padding: 3px 12px;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-4);
  }

  .guide-header__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 3vw, var(--text-3xl));
    font-weight: 400;
    font-style: italic;
    color: var(--sage);
    line-height: 1.15;
    margin-bottom: var(--space-3);
  }

  .guide-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-light);
    max-width: none;
  }

  /* ── Guide body ─────────────────────────── */
  .guide-body {
    background: var(--cream);
    padding-top: var(--space-4);
    padding-bottom: var(--space-16);
  }

  .guide-content {
    max-width: 740px;
    margin-inline: auto;
  }

  /* ── Typography ─────────────────────────── */
  .guide-content h2 {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 3.5vw, var(--text-3xl));
    font-weight: 400;
    color: var(--sage);
    margin-top: var(--space-16);
    margin-bottom: var(--space-6);
  }

  .guide-content h2:first-child { margin-top: 0; }

  .guide-content h3 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 400;
    color: var(--text-dark);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .guide-content p {
    font-size: clamp(var(--text-base), 1.6vw, var(--text-lg));
    color: var(--text-medium);
    line-height: 1.85;
    margin-bottom: var(--space-5);
    max-width: 100%;
  }

  .guide-content ul,
  .guide-content ol {
    padding-left: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .guide-content li {
    font-size: clamp(var(--text-base), 1.6vw, var(--text-lg));
    color: var(--text-medium);
    line-height: 1.75;
    margin-bottom: var(--space-3);
  }

  .guide-content strong { color: var(--text-dark); font-weight: 600; }

  .guide-content a {
    color: var(--sage);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }

  .guide-content a:hover { color: var(--terracotta); }

  /* ── Callout boxes — redesigned ─────────── */
  /* No more border-left. Full rounded, warm, editorial. */
  .callout {
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-7);
    margin-block: var(--space-10);
  }

  .callout p:last-child { margin-bottom: 0; }

  .callout--tip {
    background: var(--sage-pale);
  }

  .callout--note {
    background: var(--terracotta-pale);
  }

  .callout--official {
    background: var(--white);
    box-shadow: var(--shadow-md);
  }

  /* Callout heading — styled as a small tag pill */
  .callout__heading {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: rgba(255,255,255,0.7);
    color: var(--sage);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-4);
  }

  .callout--note .callout__heading { color: var(--terracotta); }
  .callout--official .callout__heading {
    background: var(--sage-pale);
    color: var(--sage);
  }

  /* Official links */
  .official-links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: 0;
  }

  .official-links li { margin-bottom: 0; }

  .official-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 500;
  }

  .official-links a::after {
    content: " ↗";
    font-size: 0.85em;
    opacity: 0.55;
  }

  /* Partner / Place card grids */
  .partner-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-block: var(--space-10);
  }

  @media (min-width: 600px) {
    .partner-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* ── Disclaimer ─────────────────────────── */
  .guide-disclaimer {
    max-width: 740px;
    margin-inline: auto;
    margin-top: var(--space-16);
    padding: var(--space-5) var(--space-6);
    background: var(--cream-dark);
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    color: var(--text-light);
    line-height: 1.7;
  }

  .guide-disclaimer p {
    font-size: var(--text-sm);
    color: var(--text-light);
    max-width: 100%;
    margin: 0;
  }

  .guide-disclaimer strong { color: var(--text-medium); }

  @media (prefers-reduced-motion: reduce) {
    .gh-mascot__img { animation: none; }
    .gh-spark { animation: none; }
  }
</style>
