---
// MascotPage.astro — shared layout for Explorer / Anchor / Connector pages
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GlobeCanvas from '../components/GlobeCanvas.astro';

interface Props {
  id:          string;        // "explorer" | "anchor" | "connector"
  name:        string;        // "The Explorer" etc.
  tagline:     string;
  image:       string;        // "/mascots/explorer.png"
  imageAlt:    string;
  bg:          string;        // CSS colour value for the hero tint
  city?:       string;        // "London" | "Dubai" etc. — shown in content section eyebrow
  categories:  { label: string; icon: string; href: string; }[];
}

const { id, name, tagline, image, imageAlt, bg, city = "London", categories } = Astro.props;

// Cities — globe links go to the same mascot type for each city.
// London mascot pages live at /{id}; Dubai at /dubai/{id}.
const cities = [
  { name: "London",    country: "UK",          status: "active",      pinX: "50%", pinY: "32%", href: `/${id}` },
  { name: "Dubai",     country: "UAE",         status: "active",      pinX: "64%", pinY: "40%", href: `/dubai/${id}` },
  { name: "Lisbon",    country: "Portugal",    status: "coming-soon", pinX: "44%", pinY: "40%" },
  { name: "Amsterdam", country: "Netherlands", status: "coming-soon", pinX: "51%", pinY: "31%" },
  { name: "Paris",     country: "France",      status: "coming-soon", pinX: "51%", pinY: "36%" },
];

const activeCities     = cities.filter(c => c.status === "active");
const comingSoonCities = cities.filter(c => c.status === "coming-soon");
---

<Layout title={`${name} — Landwell`}>
  <Nav />

  <!-- Mascot hero -->
  <header class="mascot-hero" style={`--hero-bg: ${bg};`}>
    <div class="container">
      <a href="/" class="mascot-hero__back">← Back to Landwell</a>

      <div class="mascot-hero__inner">
        <div class="mascot-hero__figure">
          <img
            src={image}
            alt={imageAlt}
            class="mascot-hero__img"
            width="300"
            height="340"
          />
        </div>
        <div class="mascot-hero__text">
          <p class="eyebrow">{name} ✦</p>
          <h1 class="mascot-hero__title">{tagline}</h1>
          <p class="mascot-hero__hint">Pick a city on the globe below to start.</p>
        </div>
      </div>
    </div>
  </header>

  <!-- Content categories — shown first so you can dive straight in -->
  <section id={`${id}-content`} class="mascot-content section">
    <div class="container">
      <div class="mascot-content__header">
        <span class="eyebrow">Explore {city} ✦</span>
        <h2 class="mascot-content__title">What are you looking for?</h2>
      </div>

      <div class="categories__grid">
        {categories.map((cat) => (
          <a href={cat.href} class="category-card">
            <span class="category-card__icon" aria-hidden="true">{cat.icon}</span>
            <span class="category-card__label">{cat.label}</span>
            <span class="category-card__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <p class="mascot-content__note">
        More content coming soon — this is just the beginning. ✦
      </p>
    </div>
  </section>

  <!-- Globe — explore other cities (decorative + interactive, at the bottom) -->
  <section class="mascot-globe section">
    <div class="container">
      <div class="mascot-globe__header">
        <span class="eyebrow">The world is waiting ✦</span>
        <h2 class="mascot-globe__title">Where to next?</h2>
        <p class="mascot-globe__hint">Drag the globe to explore — more cities landing soon.</p>
      </div>

      <div class="mascot-globe__stage">
        <GlobeCanvas navigatable={false} />
      </div>

      <div class="mascot-globe__cities">
        {activeCities.map((c) => (
          <a href={c.href} class="city-chip">
            <span class="city-chip__dot" aria-hidden="true"></span>
            {c.name}
            <span class="city-chip__country">{c.country}</span>
          </a>
        ))}
        {comingSoonCities.map((c) => (
          <span class="city-chip city-chip--soon">
            <span class="city-chip__dot city-chip__dot--soon" aria-hidden="true"></span>
            {c.name}
          </span>
        ))}
      </div>
    </div>
  </section>

  <Footer />

</Layout>

<style>
  /* ── Mascot hero ───────────────────────── */
  .mascot-hero {
    background: var(--hero-bg);
    padding-top: 100px;
    padding-bottom: var(--space-16);
  }

  .mascot-hero__back {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--text-medium);
    margin-bottom: var(--space-10);
    transition: color 0.2s;
  }

  .mascot-hero__back:hover { color: var(--sage); }

  .mascot-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    text-align: center;
  }

  @media (min-width: 700px) {
    .mascot-hero__inner {
      flex-direction: row;
      text-align: left;
      gap: var(--space-16);
    }
  }

  .mascot-hero__figure {
    flex-shrink: 0;
  }

  .mascot-hero__img {
    width: clamp(160px, 28vw, 280px);
    height: auto;
    mix-blend-mode: multiply;
    filter: drop-shadow(0 12px 24px rgba(74, 44, 26, 0.15));
  }

  .mascot-hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mascot-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-3xl), 5.5vw, var(--text-5xl));
    font-weight: 400;
    font-style: italic;
    color: var(--sage);
    line-height: 1.1;
  }

  .mascot-hero__hint {
    font-size: var(--text-base);
    color: var(--text-medium);
  }

  /* ── Content categories ─────────────── */
  .mascot-content {
    background: var(--cream);
  }

  .mascot-content__header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .mascot-content__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: 400;
    color: var(--sage);
  }

  .categories__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 600px) {
    .categories__grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (min-width: 900px) {
    .categories__grid { grid-template-columns: repeat(4, 1fr); }
  }

  .category-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .category-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .category-card:hover .category-card__arrow { transform: translateX(4px); }

  .category-card__icon {
    font-size: var(--text-2xl);
    line-height: 1;
  }

  .category-card__label {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--sage);
    flex: 1;
  }

  .category-card__arrow {
    font-size: var(--text-sm);
    color: var(--terracotta);
    align-self: flex-end;
    transition: transform 0.2s ease;
  }

  .mascot-content__note {
    text-align: center;
    margin-top: var(--space-12);
    font-size: var(--text-sm);
    color: var(--text-light);
    letter-spacing: 0.05em;
  }

  /* ── Globe (bottom section) ─────────── */
  .mascot-globe {
    background: linear-gradient(180deg, var(--cream-dark) 0%, #1e2b20 100%);
    padding-bottom: var(--space-20);
  }

  .mascot-globe__header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .mascot-globe__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: 400;
    font-style: italic;
    color: var(--sage);
    margin-bottom: var(--space-3);
  }

  .mascot-globe__hint {
    font-size: var(--text-sm);
    color: var(--text-light);
  }

  .mascot-globe__stage {
    width: clamp(260px, 48vw, 380px);
    margin-inline: auto;
    margin-bottom: var(--space-10);
  }

  /* CSS globe */
  .mp-globe {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    position: relative;
    overflow: hidden;
    box-shadow:
      inset -36px -22px 64px rgba(0,0,0,0.38),
      inset 16px 12px 40px rgba(255,255,255,0.07),
      0 24px 70px rgba(61,90,64,0.3),
      0 0 0 2px rgba(61,90,64,0.18);
  }

  .mp-globe::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(145deg, #4e7352 0%, #3D5A40 45%, #2b4030 100%);
    z-index: 0;
  }

  .mp-globe__surface {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image:
      repeating-linear-gradient(0deg, transparent, transparent 28px, rgba(255,255,255,0.11) 28px, rgba(255,255,255,0.11) 29px),
      repeating-linear-gradient(90deg, transparent, transparent 28px, rgba(255,255,255,0.11) 28px, rgba(255,255,255,0.11) 29px);
    animation: mp-spin 20s linear infinite;
  }

  @keyframes mp-spin {
    from { background-position: 0 0, 0 0; }
    to   { background-position: 0 0, 58px 0; }
  }

  .mp-globe__depth {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    z-index: 2;
    background:
      radial-gradient(circle at 30% 25%, rgba(255,255,255,0.2) 0%, transparent 52%),
      radial-gradient(circle at 75% 78%, rgba(0,0,0,0.42) 0%, transparent 44%);
    pointer-events: none;
  }

  .mp-globe:hover .mp-globe__surface { animation-play-state: paused; }

  .mp-globe__pin {
    position: absolute;
    left: var(--pin-x);
    top:  var(--pin-y);
    transform: translate(-50%, -50%);
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }

  .mp-globe__pin-marker {
    position: relative;
    width: 11px;
    height: 11px;
    flex-shrink: 0;
  }

  .mp-globe__pin-dot {
    position: absolute;
    inset: 0;
    background: var(--terracotta);
    border-radius: 50%;
    border: 2px solid white;
    z-index: 2;
  }

  .mp-globe__pin-pulse {
    position: absolute;
    inset: 0;
    background: var(--terracotta);
    border-radius: 50%;
    animation: mp-pulse 2.4s ease-out infinite;
    z-index: 1;
  }

  @keyframes mp-pulse {
    0%   { transform: scale(1);   opacity: 0.75; }
    100% { transform: scale(3.6); opacity: 0;    }
  }

  .mp-globe__pin-label {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: white;
    background: rgba(43,64,48,0.9);
    padding: 2px 9px;
    border-radius: var(--radius-full);
    white-space: nowrap;
    transition: background 0.2s;
  }

  .mp-globe__pin:hover .mp-globe__pin-label { background: var(--terracotta); }

  @media (prefers-reduced-motion: reduce) {
    .mp-globe__surface   { animation: none; }
    .mp-globe__pin-pulse { animation: none; }
  }

  .mascot-globe__cities {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .city-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
    background: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.7);
    border: 1px solid rgba(255,255,255,0.12);
  }

  a.city-chip:hover {
    background: rgba(200, 121, 65, 0.25);
    color: var(--terracotta-light);
    transform: translateY(-2px);
  }

  .city-chip--soon {
    opacity: 0.4;
    cursor: default;
  }

  .city-chip__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--terracotta);
    flex-shrink: 0;
  }

  .city-chip__dot--soon { background: var(--text-light); }

  .city-chip__country {
    font-size: var(--text-xs);
    opacity: 0.55;
    margin-left: var(--space-1);
  }
</style>
