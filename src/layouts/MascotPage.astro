---
// MascotPage.astro — shared layout for Explorer / Anchor / Connector pages
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GlobeCanvas from '../components/GlobeCanvas.astro';

interface Props {
  id:          string;        // "explorer" | "anchor" | "connector"
  name:        string;        // "The Explorer" etc.
  tagline:     string;
  image:       string;        // "/mascots/explorer.png"
  imageAlt:    string;
  bg:          string;        // CSS colour value for the hero tint
  city?:       string;        // "London" | "Dubai" etc. — shown in content section eyebrow
  categories:  { label: string; icon: string; href: string; }[];
}

const { id, name, tagline, image, imageAlt, bg, city = "London", categories } = Astro.props;

// Cities — globe links go to the same mascot type for each city.
// London mascot pages live at /{id}; Dubai at /dubai/{id}.
const cities = [
  { name: "London",    country: "UK",          status: "active",      pinX: "50%", pinY: "32%", href: `/${id}` },
  { name: "Dubai",     country: "UAE",         status: "active",      pinX: "64%", pinY: "40%", href: `/dubai/${id}` },
  { name: "Lisbon",    country: "Portugal",    status: "coming-soon", pinX: "44%", pinY: "40%" },
  { name: "Amsterdam", country: "Netherlands", status: "coming-soon", pinX: "51%", pinY: "31%" },
  { name: "Paris",     country: "France",      status: "coming-soon", pinX: "51%", pinY: "36%" },
];

const activeCities     = cities.filter(c => c.status === "active");
const comingSoonCities = cities.filter(c => c.status === "coming-soon");
---

<Layout title={`${name} — Landwell`}>
  <Nav />

  <!-- Hero + categories share one colour zone so there's no jarring seam -->
  <div class="mascot-zone" style={`--zone-bg: ${bg};`}>

    <!-- Compact mascot header -->
    <header class="mascot-hero">
      <div class="container">
        <a href="/" class="mascot-hero__back">← Landwell</a>
        <div class="mascot-hero__inner">
          <img
            src={image}
            alt={imageAlt}
            class="mascot-hero__img"
            width="180"
            height="210"
          />
          <div class="mascot-hero__text">
            <p class="mascot-hero__eyebrow">{name} ✦</p>
            <h1 class="mascot-hero__title">{tagline}</h1>
            <p class="mascot-hero__city">Exploring {city}</p>
          </div>
        </div>
      </div>
    </header>

    <!-- Category grid — same background as header, fades to cream -->
    <section id={`${id}-content`} class="mascot-content">
      <div class="container">

        <div class="categories__grid">
          {categories.map((cat) => {
            const live = cat.href !== '#';
            return (
              <a
                href={cat.href}
                class={`cat-card ${live ? 'cat-card--live' : 'cat-card--soon'}`}
                aria-disabled={!live ? 'true' : undefined}
                tabindex={!live ? -1 : undefined}
              >
                <!-- Circle — icon sits inside -->
                <div class="cat-card__circle">
                  <span class="cat-card__icon" aria-hidden="true">{cat.icon}</span>
                </div>
                <!-- Label + action below -->
                <div class="cat-card__body">
                  <span class="cat-card__label">{cat.label}</span>
                  {live
                    ? <span class="cat-card__cta">Explore <span class="cat-card__arrow" aria-hidden="true">→</span></span>
                    : <span class="cat-card__badge">Coming soon</span>
                  }
                </div>
              </a>
            );
          })}
        </div>

        <p class="mascot-content__note">More content added regularly ✦</p>
      </div>
    </section>

  </div><!-- end .mascot-zone -->

  <!-- Globe — explore other cities (decorative + interactive, at the bottom) -->
  <section class="mascot-globe section">
    <canvas class="stars-bg" aria-hidden="true"></canvas>
    <div class="container">
      <div class="mascot-globe__header">
        <span class="eyebrow">The world is waiting ✦</span>
        <h2 class="mascot-globe__title">Where to next?</h2>
        <p class="mascot-globe__hint">Drag the globe to explore — more cities landing soon.</p>
      </div>

      <div class="mascot-globe__stage">
        <GlobeCanvas navigatable={false} />
      </div>

      <div class="mascot-globe__cities">
        {activeCities.map((c) => (
          <a href={c.href} class="city-chip">
            <span class="city-chip__dot" aria-hidden="true"></span>
            {c.name}
            <span class="city-chip__country">{c.country}</span>
          </a>
        ))}
        {comingSoonCities.map((c) => (
          <span class="city-chip city-chip--soon">
            <span class="city-chip__dot city-chip__dot--soon" aria-hidden="true"></span>
            {c.name}
          </span>
        ))}
      </div>
    </div>
  </section>

  <Footer />

</Layout>

<style>
  /* ── Colour zone (hero + categories share one bg) ─── */
  .mascot-zone {
    background: var(--zone-bg);
    /* Fade into cream at the bottom so globe section connects smoothly */
    padding-bottom: var(--space-2);
    position: relative;
  }

  .mascot-zone::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 120px;
    background: linear-gradient(to bottom, transparent, var(--cream));
    pointer-events: none;
  }

  /* ── Compact hero ──────────────────── */
  .mascot-hero {
    padding-top: 100px;
    padding-bottom: var(--space-8);
  }

  .mascot-hero__back {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--text-medium);
    margin-bottom: var(--space-6);
    text-decoration: none;
    transition: color 0.2s;
  }
  .mascot-hero__back:hover { color: var(--sage); }

  .mascot-hero__inner {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .mascot-hero__img {
    width: clamp(90px, 14vw, 150px);
    height: auto;
    flex-shrink: 0;
    mix-blend-mode: multiply;
    filter: drop-shadow(0 6px 16px rgba(74, 44, 26, 0.12));
  }

  .mascot-hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mascot-hero__eyebrow {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--terracotta);
    opacity: 0.8;
  }

  .mascot-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 3.5vw, var(--text-4xl));
    font-weight: 400;
    font-style: italic;
    color: var(--sage);
    line-height: 1.15;
  }

  .mascot-hero__city {
    font-size: var(--text-sm);
    color: var(--text-medium);
  }

  /* ── Category grid ─────────────────── */
  .mascot-content {
    padding-block: var(--space-6) var(--space-20);
    position: relative;
    z-index: 1;
  }

  .categories__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
  }

  @media (min-width: 640px)  { .categories__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 960px)  { .categories__grid { grid-template-columns: repeat(4, 1fr); } }

  /* ── Circle category cards ──────── */
  .cat-card {
    display: flex;
    flex-direction: column;
    /* No align-items — default stretch fills the full grid cell width,
       which is what lets the circle go square via aspect-ratio */
    text-decoration: none;
    color: inherit;
    transition: transform 0.28s ease;
  }

  .cat-card--live:hover {
    transform: translateY(-8px);
  }

  .cat-card--live:hover .cat-card__arrow { transform: translateX(4px); }

  .cat-card--soon {
    opacity: 0.55;
    cursor: default;
  }

  /* Circle — no explicit width, parent stretch + aspect-ratio guarantees a square */
  .cat-card__circle {
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--cream-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 18px rgba(61, 90, 64, 0.16);
    transition: box-shadow 0.28s ease;
  }

  .cat-card--live:hover .cat-card__circle {
    box-shadow: 0 8px 28px rgba(61, 90, 64, 0.22);
  }

  .cat-card--soon .cat-card__circle {
    box-shadow: 0 2px 8px rgba(61, 90, 64, 0.08);
  }

  .cat-card__icon {
    font-size: 2.4rem;
    line-height: 1;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.08));
    transition: transform 0.28s ease;
  }

  .cat-card--live:hover .cat-card__icon {
    transform: scale(1.12) translateY(-4px);
  }

  /* Label + CTA below the circle */
  .cat-card__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-3);
    text-align: center;
  }

  .cat-card__label {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 400;
    font-style: italic;
    color: var(--sage);
    line-height: 1.25;
  }

  .cat-card--soon .cat-card__label { color: var(--text-medium); }

  .cat-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--terracotta);
    margin-top: var(--space-1);
  }

  .cat-card__arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .cat-card__badge {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-light);
    margin-top: var(--space-1);
  }

  .mascot-content__note {
    text-align: center;
    margin-top: var(--space-12);
    font-size: var(--text-sm);
    color: var(--text-light);
    letter-spacing: 0.05em;
  }

  /* ── Globe (bottom section) ─────────── */
  .mascot-globe {
    background: #05090f;
    padding-bottom: var(--space-20);
    position: relative;
    overflow: hidden;
  }

  /* Stars canvas — fills the section behind all content */
  .stars-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  /* Content sits above the star field */
  .mascot-globe > .container {
    position: relative;
    z-index: 1;
  }

  .mascot-globe__header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  /* Override global eyebrow colour for dark bg */
  .mascot-globe .eyebrow {
    color: rgba(200, 121, 65, 0.85);
  }

  .mascot-globe__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: 400;
    font-style: italic;
    color: var(--cream);
    margin-bottom: var(--space-3);
  }

  .mascot-globe__hint {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.42);
  }

  .mascot-globe__stage {
    width: clamp(260px, 48vw, 380px);
    margin-inline: auto;
    margin-bottom: var(--space-10);
  }

  /* CSS globe */
  .mp-globe {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    position: relative;
    overflow: hidden;
    box-shadow:
      inset -36px -22px 64px rgba(0,0,0,0.38),
      inset 16px 12px 40px rgba(255,255,255,0.07),
      0 24px 70px rgba(61,90,64,0.3),
      0 0 0 2px rgba(61,90,64,0.18);
  }

  .mp-globe::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(145deg, #4e7352 0%, #3D5A40 45%, #2b4030 100%);
    z-index: 0;
  }

  .mp-globe__surface {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image:
      repeating-linear-gradient(0deg, transparent, transparent 28px, rgba(255,255,255,0.11) 28px, rgba(255,255,255,0.11) 29px),
      repeating-linear-gradient(90deg, transparent, transparent 28px, rgba(255,255,255,0.11) 28px, rgba(255,255,255,0.11) 29px);
    animation: mp-spin 20s linear infinite;
  }

  @keyframes mp-spin {
    from { background-position: 0 0, 0 0; }
    to   { background-position: 0 0, 58px 0; }
  }

  .mp-globe__depth {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    z-index: 2;
    background:
      radial-gradient(circle at 30% 25%, rgba(255,255,255,0.2) 0%, transparent 52%),
      radial-gradient(circle at 75% 78%, rgba(0,0,0,0.42) 0%, transparent 44%);
    pointer-events: none;
  }

  .mp-globe:hover .mp-globe__surface { animation-play-state: paused; }

  .mp-globe__pin {
    position: absolute;
    left: var(--pin-x);
    top:  var(--pin-y);
    transform: translate(-50%, -50%);
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }

  .mp-globe__pin-marker {
    position: relative;
    width: 11px;
    height: 11px;
    flex-shrink: 0;
  }

  .mp-globe__pin-dot {
    position: absolute;
    inset: 0;
    background: var(--terracotta);
    border-radius: 50%;
    border: 2px solid white;
    z-index: 2;
  }

  .mp-globe__pin-pulse {
    position: absolute;
    inset: 0;
    background: var(--terracotta);
    border-radius: 50%;
    animation: mp-pulse 2.4s ease-out infinite;
    z-index: 1;
  }

  @keyframes mp-pulse {
    0%   { transform: scale(1);   opacity: 0.75; }
    100% { transform: scale(3.6); opacity: 0;    }
  }

  .mp-globe__pin-label {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: white;
    background: rgba(43,64,48,0.9);
    padding: 2px 9px;
    border-radius: var(--radius-full);
    white-space: nowrap;
    transition: background 0.2s;
  }

  .mp-globe__pin:hover .mp-globe__pin-label { background: var(--terracotta); }

  @media (prefers-reduced-motion: reduce) {
    .mp-globe__surface   { animation: none; }
    .mp-globe__pin-pulse { animation: none; }
  }

  .mascot-globe__cities {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .city-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
    background: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.7);
    border: 1px solid rgba(255,255,255,0.12);
  }

  a.city-chip:hover {
    background: rgba(200, 121, 65, 0.25);
    color: var(--terracotta-light);
    transform: translateY(-2px);
  }

  .city-chip--soon {
    opacity: 0.4;
    cursor: default;
  }

  .city-chip__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--terracotta);
    flex-shrink: 0;
  }

  .city-chip__dot--soon { background: var(--text-light); }

  .city-chip__country {
    font-size: var(--text-xs);
    opacity: 0.55;
    margin-left: var(--space-1);
  }
</style>

<script is:inline>
(function () {
  var canvas = document.querySelector('.stars-bg:not([data-init])');
  if (!canvas) return;
  canvas.dataset.init = '1';

  var section = canvas.parentElement;
  var ctx     = canvas.getContext('2d');
  var W = 0, H = 0;

  function resize() {
    W = section.offsetWidth  || window.innerWidth;
    H = section.offsetHeight || 600;
    canvas.width  = W;
    canvas.height = H;
  }
  resize();
  window.addEventListener('resize', resize);

  /* ── Star data ────────────────────────────────────── */
  var COLS  = ['255,255,255', '200,220,255', '255,248,210', '180,210,255'];
  var COUNT = 240;
  var stars = [];
  for (var i = 0; i < COUNT; i++) {
    stars.push({
      x:     Math.random(),
      y:     Math.random(),
      r:     Math.pow(Math.random(), 2.5) * 2.4 + 0.25,  // biased toward tiny
      base:  Math.random() * 0.50 + 0.20,
      amp:   Math.random() * 0.50 + 0.10,
      speed: Math.random() * 1.4  + 0.15,
      phase: Math.random() * Math.PI * 2,
      col:   COLS[Math.floor(Math.random() * COLS.length)],
    });
  }

  /* ── Nebula patches (subtle, drawn once per resize) ─ */
  var nebulae = [
    { x: 0.12, y: 0.18, r: 0.30, col: '70,35,130',  op: 0.055 },
    { x: 0.85, y: 0.72, r: 0.28, col: '20,55,130',  op: 0.065 },
    { x: 0.50, y: 0.08, r: 0.22, col: '35,70,150',  op: 0.040 },
    { x: 0.78, y: 0.25, r: 0.18, col: '60,20,100',  op: 0.035 },
  ];

  function drawNebulae() {
    for (var i = 0; i < nebulae.length; i++) {
      var n = nebulae[i];
      var cx = n.x * W, cy = n.y * H, rad = n.r * Math.min(W, H);
      var g  = ctx.createRadialGradient(cx, cy, 0, cx, cy, rad);
      g.addColorStop(0, 'rgba(' + n.col + ',' + n.op + ')');
      g.addColorStop(1, 'rgba(' + n.col + ',0)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(cx, cy, rad, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  /* ── Animation loop ───────────────────────────────── */
  function draw(t) {
    ctx.clearRect(0, 0, W, H);
    drawNebulae();

    for (var i = 0; i < stars.length; i++) {
      var s  = stars[i];
      var op = s.base + Math.sin(t * s.speed + s.phase) * s.amp;
      op = op < 0.03 ? 0.03 : op > 1 ? 1 : op;
      ctx.beginPath();
      ctx.arc(s.x * W, s.y * H, s.r, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(' + s.col + ',' + op.toFixed(2) + ')';
      ctx.fill();
    }

    requestAnimationFrame(function (ms) { draw(ms * 0.001); });
  }

  requestAnimationFrame(function (ms) { draw(ms * 0.001); });
})();
</script>
